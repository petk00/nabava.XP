# JWT tajni ključ — OBAVEZNO za docker compose
# Generiraj s: openssl rand -base64 48
JWT_SECRET=

# MySQL lozinke — OBAVEZNO za docker compose
# Generiraj s: openssl rand -base64 24
DB_ROOT_PASSWORD=
DB_PASSWORD=

# IP adresa servera — za pristup s drugog računala na mreži
# Primjer: SERVER_IP=192.168.1.100
# Ostavi prazno za testiranje samo na istom računalu (localhost)
SERVER_IP=

# AI asistent (docs/AI.md) — opcionalno.
# Aktivni provider (ollama/gemini) i Gemini model su runtime postavke u bazi
# (PUT /api/assistant/settings), ali adresa Ollame i Gemini ključ dolaze odavde.
# Default je Ollama koja radi na HOSTU (http://host.docker.internal:11434).
# Za Ollamu kao kontejner: `docker compose --profile ollama up -d` + OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=
GEMINI_API_KEY=
